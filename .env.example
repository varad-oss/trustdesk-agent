# Everything is free and local. No API keys are needed anywhere.
# ollama (default) | openai_compat (llama.cpp server, LM Studio, vLLM) | fake (rule-based demo, not an LLM)
TRUSTDESK_PROVIDER=ollama
TRUSTDESK_MODEL=qwen3:8b
TRUSTDESK_SIM_PROVIDER=ollama
TRUSTDESK_SIM_MODEL=qwen3:8b
TRUSTDESK_OLLAMA_URL=http://localhost:11434
# Context window requested from Ollama (prompt + 12 tool schemas need ~3K tokens; conversations grow)
TRUSTDESK_NUM_CTX=16384
# qwen3 "thinking" mode: slower, sometimes more careful. Measure before turning on.
TRUSTDESK_THINK=false
TRUSTDESK_DEFENSE_LEVEL=3
# hybrid | bm25 | dense (embeddings run locally via fastembed)
TRUSTDESK_RETRIEVAL_MODE=hybrid
# Another local OpenAI-compatible server, if you use provider=openai_compat
TRUSTDESK_OPENAI_BASE_URL=http://localhost:8080/v1
# Development-only response cache; must be unset for reported runs
# TRUSTDESK_LLM_CACHE_DIR=.cache/llm
# Optional SELF-HOSTED Langfuse (free, Docker). Leave empty to use local JSONL traces only.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
