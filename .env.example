# Copy to .env (gitignored). Never commit real keys.
ANTHROPIC_API_KEY=
# anthropic | openai_compat | fake (rule-based demo, no key needed)
TRUSTDESK_PROVIDER=anthropic
TRUSTDESK_MODEL=claude-haiku-5-5
TRUSTDESK_EFFORT=low
TRUSTDESK_SIM_PROVIDER=anthropic
TRUSTDESK_SIM_MODEL=claude-haiku-5-5
TRUSTDESK_DEFENSE_LEVEL=3
# hybrid | bm25 | dense
TRUSTDESK_RETRIEVAL_MODE=hybrid
# OpenAI-compatible endpoint for cheap development (e.g. Ollama)
TRUSTDESK_OPENAI_BASE_URL=http://localhost:11434/v1
TRUSTDESK_OPENAI_API_KEY=
# Development-only response cache; must be unset for reported runs
# TRUSTDESK_LLM_CACHE_DIR=.cache/llm
# Optional Langfuse (cloud free tier or self-hosted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
